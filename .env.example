# Copy to .env. Never commit .env.
# The client also accepts legal-memory-retrieval/.env when this folder
# still sits inside the monorepo and no local .env is present.

# Agent backend (config provider: azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Judges, sleep, commit gate, retrieval scorer, dataset author (provider: bedrock)
BEDROCK_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
